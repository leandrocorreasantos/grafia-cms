# ============================================
# Grafia CMS - .env da raiz
# Uso: servidor raiz (server.js) e scripts utilitarios
# ============================================

# Ambiente do processo raiz
NODE_ENV="development"

# Porta do servidor raiz (server.js)
PORT=3000

# URL publica para links e CORS do servidor raiz
PUBLIC_URL="http://localhost:3000"

# CORS do servidor raiz (separar por virgula quando houver mais de uma origem)
CORS_ORIGIN="http://localhost:3000"

# Rate limit do servidor raiz
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Observacao:
# Variaveis da API/Prisma (DATABASE_URL, JWT_SECRET etc.)
# devem ficar em apps/api/.env