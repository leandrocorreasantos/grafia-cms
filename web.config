<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================
  GRAFIA CMS - IIS CONFIG
  ============================================
  Use apenas se estiver usando IIS como proxy reverso
  para o Node.js (porta 3000).
  Requer: URL Rewrite Module e Application Request Routing (ARR)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy to Node.js" stopProcessing="true">
          <match url="^(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/(assets|content)/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/health" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Segurança -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="logs" />
          <add segment="data" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Headers de segurança -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Cache de conteúdo estático -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
