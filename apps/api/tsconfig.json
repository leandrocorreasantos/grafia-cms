{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "node16",
        "target": "ES2020",
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@domain/*": [
                "./domain/*"
            ],
            "@application/*": [
                "./application/*"
            ],
            "@infrastructure/*": [
                "./infrastructure/*"
            ]
        },
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmit": false
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "prisma"
    ]
}