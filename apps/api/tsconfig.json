{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "node16",
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "@/*": ["./*"],
            "@domain/*": ["./domain/*"],
            "@application/*": ["./application/*"],
            "@infrastructure/*": ["./infrastructure/*"]
        },
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmit": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "prisma"]
}
