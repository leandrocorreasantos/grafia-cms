{
    "name": "@grafia/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --config ./jest.config.cjs",
        "test:integration": "jest --config ./jest.config.cjs --testPathPattern='tests/integration/' --verbose",
        "test:unit": "jest --config ./jest.config.cjs --testPathPattern='tests/unit/' --verbose",
        "test:watch": "jest --config ./jest.config.cjs --watch",
        "test:coverage": "jest --config ./jest.config.cjs --coverage",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "db:seed": "ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@grafia/shared": "*",
        "@prisma/client": "^5.0.0",
        "archiver": "^7.0.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^4.18.0",
        "jsonwebtoken": "^9.0.0",
        "multer": "^2.0.2",
        "music-metadata": "^11.9.0",
        "sanitize-html": "^2.17.0",
        "sharp": "^0.34.3",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@types/archiver": "^6.0.3",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/multer": "^2.0.0",
        "@types/sanitize-html": "^2.16.0",
        "@types/node": "^20.0.0",
        "@types/supertest": "^7.2.0",
        "@types/uuid": "^9.0.7",
        "jest": "^30.4.2",
        "prisma": "^5.0.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.0"
    }
}
