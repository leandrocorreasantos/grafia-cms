# ============================================
# Grafia CMS API - apps/api/.env
# Uso: API Express + Prisma
# ============================================

# Banco de dados (Prisma)
DATABASE_URL="postgresql://grafia_user:grafia_pass@localhost:5432/grafia_db?schema=public"

# Seguranca
JWT_SECRET="troque-esta-chave-em-producao"

# Ambiente da API
NODE_ENV="development"
PORT=3001
