{
    "name": "grafia-cms",
    "version": "0.1.0",
    "description": "Grafia CMS - Onde suas palavras ganham forma",
    "type": "module",
    "bin": {
        "grafia": "./scripts/cli.js"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "npm run dev --workspace=apps/api",
        "dev:web": "npm run dev --workspace=apps/web",
        "build": "npm run build --workspaces && npm run build:dist",
        "build:dist": "node scripts/build-dist.js",
        "start": "NODE_ENV=production node server.js",
        "start:dev": "NODE_ENV=development node server.js",
        "install": "node scripts/install.js",
        "setup": "node scripts/setup.js",
        "setup:db": "node scripts/setup-db.js",
        "security": "node scripts/security-check.js",
        "pm2:start": "pm2 start ecosystem.config.js",
        "pm2:stop": "pm2 stop grafia-cms",
        "pm2:restart": "pm2 restart grafia-cms",
        "pm2:logs": "pm2 logs grafia-cms",
        "db:generate": "npx prisma generate",
        "db:migrate": "npx prisma migrate dev",
        "db:deploy": "npx prisma migrate deploy",
        "db:studio": "npx prisma studio",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "concurrently": "^8.2.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^16.3.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.0",
        "pm2": "^5.3.0",
        "prisma": "^5.0.0",
        "uuid": "^9.0.0"
    }
}
